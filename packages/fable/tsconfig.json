{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@core/*": ["./source/core/*"]
    }
  },
  "include": [
    "source/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": ["**/node_modules", "**/dist", "**/build", "**/coverage"]
}
